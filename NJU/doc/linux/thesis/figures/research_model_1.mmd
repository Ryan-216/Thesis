%%{init: {'theme': 'base', 'themeVariables': {'fontSize': '15px', 'primaryColor': '#fff', 'primaryBorderColor': '#000', 'lineColor': '#000', 'primaryTextColor': '#000', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#e8e8e8'}}}%%
flowchart LR
    UD["非定向信息披露<br/>（UD<sub>t</sub>）"]
    TD["定向信息披露<br/>（TD<sub>t</sub>）"]

    subgraph DV["开发者活动"]
        Code["代码活动<br/>（Code<sub>it</sub>）"]
        Review["审查活动<br/>（Review<sub>it</sub>）"]
        Issue["讨论活动<br/>（Issue<sub>it</sub>）"]
    end

    UD -->|"H1（+）效价：结果的感知价值"| DV
    TD -->|"H2（+）工具性：绩效→结果"| DV
    UD --- INT((" "))
    TD --- INT
    INT -->|"H3（−）期望失验"| DV

    style UD fill:#fff,stroke:#000,stroke-width:2px
    style TD fill:#fff,stroke:#000,stroke-width:2px
    style Code fill:#f0f0f0,stroke:#000,stroke-width:1px
    style Review fill:#f0f0f0,stroke:#000,stroke-width:1px
    style Issue fill:#f0f0f0,stroke:#000,stroke-width:1px
    style DV fill:#e8e8e8,stroke:#000,stroke-width:2px
    style INT fill:#000,stroke:#000,stroke-width:1px,color:#fff
